{
  "name": "zhitiku-desktop",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BBkjdayup/BCTK.git"
  },
  "bugs": {
    "url": "https://github.com/BBkjdayup/BCTK/issues"
  },
  "homepage": "https://github.com/BBkjdayup/BCTK#readme",
  "packageManager": "pnpm@11.19.0",
  "version": "0.1.83",
  "type": "module",
  "scripts": {
    "predev": "pnpm version:check",
    "dev": "vite",
    "prebuild": "pnpm version:check",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm test",
    "test:unit": "vitest run",
    "test:word:real": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-real-word.ps1",
    "test": "vue-tsc --noEmit && vitest run",
    "preview": "vite preview",
    "website:dev": "vite --config website/vite.config.mjs",
    "website:build": "vite build --config website/vite.config.mjs",
    "website:preview": "vite preview --config website/vite.config.mjs",
    "tauri": "tauri",
    "build:installer": "tauri build --config src-tauri/tauri.local-build.conf.json",
    "release:update": "pwsh -NoProfile -File scripts/build-signed-update.ps1",
    "version:check": "node scripts/sync-version.mjs --check",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@hufe921/canvas-editor": "0.9.137",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-subscript": "3.31.0",
    "@tiptap/extension-superscript": "3.31.0",
    "@tiptap/extension-table": "3.31.0",
    "@tiptap/extension-underline": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "@tiptap/vue-3": "3.31.0",
    "element-plus": "^2.14.2",
    "katex": "0.18.1",
    "pinia": "^3.0.4",
    "sortablejs": "1.15.6",
    "vue": "^3.5.13",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/vue": "^8.1.0",
    "@types/katex": "0.16.8",
    "@types/node": "^22.20.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.64.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "~8.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  }
}
